  "pages": {
    "soybean": {
      "slug": "soybean",
      "name": "大豆",
      "codes": "A · B · CBOT S",
      "updatedAt": "",
      "summary": "大豆是全球最重要的油籽作物之一，价格由主产国种植与天气、国际贸易、中国进口和国内压榨需求共同决定。研究大豆需要区分国产食用大豆、进口压榨大豆和 CBOT 全球定价三个市场，并沿“大豆—豆粕/豆油—饲料与油脂消费”的产业链观察供需传导。",
      "pageText": {
        "siteName": "农产品研究 Wiki",
        "mapNavLabel": "品种关系",
        "breadcrumbRootLabel": "品种关系",
        "updatedPrefix": "数据框架更新于",
        "relations": {
          "index": "07",
          "title": "关联品种",
          "description": "大豆压榨后分成两条并列支线：豆粕进入饲料和养殖，豆油进入食用油并与棕榈油、菜籽油形成替代。关联关系不是“豆粕—生猪—豆油”的单一路径。",
          "fullMapLink": "查看完整品种关系图 →"
